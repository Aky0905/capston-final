EXPO_PUBLIC_MODE=demo
# 실제 연동 시 cloud로 변경하고 아래 값을 입력하세요. 휴대폰에서는 localhost 대신 PC의 LAN IP를 사용합니다.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# 선택: HTTPS로 배포한 player/index.html 주소. 로컬 개발에는 backend /player를 사용합니다.
EXPO_PUBLIC_PLAYER_URL=
